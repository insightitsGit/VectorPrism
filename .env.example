# VectorPrism environment (copy to .env — never commit secrets)

# Postgres / pgvector (Docker Compose default maps host 5433 -> container 5432)
VECTORPRISM_PG_DSN=postgresql://vectorprism:vectorprism@localhost:5433/vectorprism

# Optional Qdrant
# VECTORPRISM_QDRANT_URL=http://localhost:6333

# Optional Hugging Face token (faster model downloads in Docker)
# HF_TOKEN=

# Encoder used for production demos
VECTORPRISM_ENCODER=sentence-transformers/all-mpnet-base-v2
